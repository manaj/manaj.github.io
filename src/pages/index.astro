---
import PageLayout from "../layouts/default.astro";
const title = "Portfolio of Manaj Chakrobarti";
const bodyClass = "home";
import "../styles/homepage.scss";
---

<PageLayout title={title} bodyClass={bodyClass}>
	<main class="box homepage">
		<section class="inner">
			<div class="hero grid-holder">
				<div class="intro">
					<h1>
						Hej! I’m Manaj, a Product Designer with 17 years of
						experience making complex things simple and simple
						things beautiful. I solve problems, push pixels, and
						occasionally vibe code from a small town in Sweden.
					</h1>
				</div>
			</div>

			<div class="works">
				<h2>Fetured Works</h2>
				<ul class="no-list">
					<li class="full">
						<a
							href="/works/opti-dam-home-page-redesign"
							class="single"
						>
							<div class="image col-8">
								<img
									src="/images/works/homepage/library.png"
									alt="Opti Library Redesign "
								/>
							</div>
							<h4 class="title col-4">
								Redesiging Optimizely's Digital Asset Management
								(DAM) System
							</h4>
						</a>
					</li>
					<li class="full">
						<a class="single" href="/works/opti-design-systems">
							<div class="image">
								<img
									src="/images/works/homepage/works-design-system.png"
									alt="Design Systems"
								/>
							</div>
						</a>
					</li>

					<li>
						<a
							class="single"
							href="/works/opti-product-recommendation-suite"
						>
							<div class="image">
								<img
									src="/images/works/homepage/product-recommandation.png"
									alt="Product
									Recommendation"
								/>
							</div>
							<h4 class="title">
								Product Recommendations Widgets Management
							</h4>
						</a>
					</li>

					<li>
						<a class="single" href="/works/opti-marketing-website">
							<div class="image">
								<img
									src="/images/works/homepage/opti-website.png"
									alt="Homepage redesign"
								/>
							</div>
							<h4 class="title">Reimagining the CMS Homepage</h4>
						</a>
					</li>

					<li>
						<a class="single" href="/works/speculative-design">
							<div class="image">
								<img
									src="/images/works/homepage/speculative-design.png"
									alt="Speculative Design"
								/>
							</div>
							<h4 class="title">Halmstad Z - A card game</h4>
						</a>
					</li>

					<li>
						<a class="single" href="/works/design-studio">
							<div class="image">
								<img
									src="/images/works/homepage/lillabaslid.png"
									alt="Design Studio - lilla Baslid"
								/>
							</div>
							<h4 class="title">
								Designing a playful mixed-reality experience
							</h4>
						</a>
					</li>
					<li>
						<a
							class="single"
							href="/works/prototyping-experiences-game"
						>
							<div class="image">
								<img
									src="/images/works/homepage/storywalk.png"
									alt="Storywalk"
								/>
							</div>
							<h4 class="title">Story walk: an immersive game</h4>
						</a>
					</li>

					<li>
						<a
							class="single"
							href="/works/designing-experiences-e202"
						>
							<div class="image">
								<img
									src="/images/works/homepage/documentr.png"
									alt="Documentr - a app for documentation management"
								/>
							</div>
							<h4 class="title">
								Group documentation management and publication
								system
							</h4>
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>
	<script>
		const figures = document.querySelectorAll(".image");

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.1 },
		);

		figures.forEach((el) => observer.observe(el));
	</script>
</PageLayout>
