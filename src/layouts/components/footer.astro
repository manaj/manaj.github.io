<footer class="footer">
    <section class="box">
        <div class="inner">
            <div class="message">
                <div class="image">
                    <img
                        src="/images/profile.png"
                        alt="Profile picture of Manaj"
                    />
                </div>
                <div class="text">
                    <h2>
                        Thanks for stopping by! If something caught your eye or
                        you’d like to talk about a job, a project, or just an
